{
  "name": "Edu Contacts Agent (n8n 1.123.18)",
  "nodes": [
    {
      "parameters": {},
      "id": "manual_trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1200,
        100
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "regionsCsv",
              "value": "Москва,Санкт-Петербург,Московская область,Ленинградская область,Новосибирская область,Свердловская область,Краснодарский край,Республика Татарстан"
            },
            {
              "name": "orgTypesCsv",
              "value": "школа,детский сад,лицей,гимназия,центр дополнительного образования,кружок"
            }
          ],
          "number": [
            {
              "name": "searchResultsPerQuery",
              "value": 10
            }
          ]
        }
      },
      "id": "set_seed",
      "name": "Set Seeds",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -980,
        100
      ]
    },
    {
      "parameters": {
        "functionCode": "const regions = ($json.regionsCsv || '').split(',').map(s => s.trim()).filter(Boolean);\nconst orgTypes = ($json.orgTypesCsv || '').split(',').map(s => s.trim()).filter(Boolean);\nconst perQuery = Number($json.searchResultsPerQuery || 10);\nconst out = [];\nfor (const region of regions) {\n  for (const orgType of orgTypes) {\n    out.push({\n      json: {\n        region,\n        orgType,\n        perQuery,\n        query: `официальный сайт ${orgType} ${region} директор телефон email`\n      }\n    });\n  }\n}\nreturn out;"
      },
      "id": "build_queries",
      "name": "Build Queries",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -760,
        100
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split_in_batches",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -550,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://google.serper.dev/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "={{$env.SERPER_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"q\": $json.query,\n  \"gl\": \"ru\",\n  \"hl\": \"ru\",\n  \"num\": $json.perQuery\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "search_serper",
      "name": "Search (Serper)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -330,
        100
      ]
    },
    {
      "parameters": {
        "functionCode": "const region = $item(0).$node['Split In Batches'].json.region;\nconst orgType = $item(0).$node['Split In Batches'].json.orgType;\nconst organic = $json.organic || [];\nreturn organic.map((r) => ({\n  json: {\n    region,\n    orgType,\n    sourceUrl: r.link || '',\n    orgName: r.title || '',\n    snippet: r.snippet || ''\n  }\n}));"
      },
      "id": "parse_search_results",
      "name": "Parse Search Results",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -110,
        100
      ]
    },
    {
      "parameters": {
        "url": "={{$json.sourceUrl}}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "string"
            }
          },
          "timeout": 15000
        }
      },
      "id": "fetch_page",
      "name": "Fetch Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        100
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "functionCode": "function firstMatch(text, regex) {\n  const m = text.match(regex);\n  return m ? m[0] : '';\n}\n\nconst item = $item(0).$node['Parse Search Results'].json;\nconst html = typeof $json === 'string' ? $json : (JSON.stringify($json || {}));\nconst text = `${item.orgName}\n${item.snippet}\n${html}`;\n\nconst emailRegex = /[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/ig;\nconst phoneRegex = /(?:\\+7|8)[\\s(\\-]*\\d{3}[\\s)\\-]*\\d{3}[\\s\\-]*\\d{2}[\\s\\-]*\\d{2}/g;\nconst fioRegex = /(?:директор|заведующ(?:ий|ая)|руководитель)[:\\s]*([А-ЯЁ][а-яё]+\\s+[А-ЯЁ][а-яё]+(?:\\s+[А-ЯЁ][а-яё]+)?)/i;\n\nconst emails = Array.from(new Set((text.match(emailRegex) || []).map(e => e.toLowerCase())));\nconst phones = Array.from(new Set((text.match(phoneRegex) || []).map(p => p.replace(/\\s+/g, ' ').trim())));\n\nconst mobile = phones.find(p => /\\+7|8/.test(p)) || '';\nconst cityPhone = phones.find(p => p !== mobile) || '';\n\nlet leader = '';\nconst fioMatch = text.match(fioRegex);\nif (fioMatch) leader = fioMatch[1].trim();\n\nconst now = new Date();\nconst currentYear = now.getFullYear().toString();\nconst freshSignals = [currentYear, (now.getFullYear() - 1).toString(), 'обновлено', 'актуаль', 'контакты'];\nconst freshnessScore = freshSignals.reduce((acc, s) => acc + (text.toLowerCase().includes(s.toLowerCase()) ? 1 : 0), 0);\n\nreturn [{\n  json: {\n    region: item.region,\n    organizationType: item.orgType,\n    organizationName: item.orgName,\n    leaderFullName: leader,\n    mobilePhone: mobile,\n    landlinePhone: cityPhone,\n    email: emails[0] || '',\n    sourceUrl: item.sourceUrl,\n    freshnessScore,\n    checkedAt: now.toISOString()\n  }\n}];"
      },
      "id": "extract_contacts",
      "name": "Extract Contacts",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        350,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.freshnessScore}}",
              "operation": "largerEqual",
              "value2": 2
            }
          ],
          "string": [
            {
              "value1": "={{$json.organizationName}}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{$json.leaderFullName}}",
              "operation": "isNotEmpty"
            }
          ]
        },
        "combineOperation": "all"
      },
      "id": "filter_valid",
      "name": "Filter Valid & Fresh",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        580,
        100
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{$env.GSHEET_ID}}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Контакты"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Регион": "={{$json.region}}",
            "Вид организации": "={{$json.organizationType}}",
            "Название организации": "={{$json.organizationName}}",
            "ФИО руководителя": "={{$json.leaderFullName}}",
            "Телефон сотовый": "={{$json.mobilePhone}}",
            "Телефон городской": "={{$json.landlinePhone}}",
            "Емайл": "={{$json.email}}",
            "Источник": "={{$json.sourceUrl}}",
            "Дата проверки": "={{$json.checkedAt}}"
          },
          "matchingColumns": [
            "Регион",
            "Вид организации",
            "Название организации",
            "ФИО руководителя"
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "id": "upsert_sheets",
      "name": "Upsert to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        820,
        50
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {},
      "id": "next_batch",
      "name": "Next Batch",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        820,
        200
      ]
    }
  ],
